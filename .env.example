# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API Keys). .env.local is ignored by git, so the values stay on your machine.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (starts with sb_publishable_), or the older "anon" key. Never put the secret/service_role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: the public address of the deployed site, used in emailed links when the request has no origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
